# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=change-me

# The backend reads this one value. On Railway, reference the Postgres service
# rather than hardcoding: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://library:change-me@db:5432/library

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Required. The API refuses to start without it. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h
PORT=3001
NODE_ENV=production

# Browser origins allowed to call the API, comma separated. Leave empty to
# allow same-origin and non-browser callers only. '*' is ignored on purpose:
# a wildcard lets any site make credentialed calls as a signed-in member.
CORS_ORIGIN=https://frontend-production-48703.up.railway.app

# Lending policy.
LOAN_DAYS=21
MAX_OPEN_LOANS=5
MAX_RENEWALS=2

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# BUILD TIME, not runtime: Vite bakes this into the bundle, so changing it
# needs a rebuild and redeploy, not a restart. Include the scheme — a bare
# hostname is a relative URL to the browser and resolves against the frontend
# origin instead of the API.
VITE_API_URL=https://backend-production-c8518.up.railway.app

# ---------------------------------------------------------------------------
# Source-IP access control
#
# Railway has no native inbound IP allowlist (its edge WAF only offers Under
# Attack Mode), so this is enforced in-process. Set these on BOTH the backend
# and frontend services — each has its own public domain and is reachable
# independently.
#
# This FAILS CLOSED: if ALLOWED_IPS is unset, empty, or contains an entry that
# cannot be parsed, every request is denied. Running open must be stated
# explicitly with IP_ALLOWLIST_MODE=disabled.
# ---------------------------------------------------------------------------

# Allowed source IPs and CIDR ranges, IPv4 and IPv6. Separate with commas,
# spaces or newlines. A bare address is an exact host match.
#   ALLOWED_IPS=203.0.113.4, 198.51.100.0/24, 2001:db8:abcd::/48
# Write IPv4 ranges in dotted-quad form (198.51.100.0/24), never v6-mapped:
# ::ffff:198.51.100.0/24 parses as a literal IPv6 /24 and matches far too much.
# One unparseable entry denies everything, so check the startup log after edits.
# Add fd00::/8 if other Railway services must reach this one over the private
# network (private-network traffic arrives with no X-Forwarded-For, so it is
# judged on its source address and is denied unless allowlisted).
ALLOWED_IPS=

# enforce      deny anything not on the list (default)
# report-only  allow everything, but log what would have been denied. Use this
#              to validate the list before switching to enforce.
# disabled     no filtering at all. Explicit, auditable opt-out.
IP_ALLOWLIST_MODE=enforce

# Number of trusted proxies that APPEND to X-Forwarded-For. The client IP is
# read that many entries in from the right, so client-supplied values (which
# land further left) are ignored.
#   1  a single proxy in front of the service
#   2  Railway's *.up.railway.app domains, which are proxied twice
#   0  no proxy: ignore X-Forwarded-For entirely and use the socket address
# If the resolved IP in the deny log disagrees with the client address your
# platform reports, this number is wrong.
TRUSTED_PROXY_HOPS=2

# Optional. Overrides X-Forwarded-For with a single-value header. With
# Cloudflare in front, prefer this over raising TRUSTED_PROXY_HOPS:
#   CLIENT_IP_HEADER=cf-connecting-ip
# Only set this if your edge overwrites the header on every request, otherwise
# a client can simply send it themselves.
CLIENT_IP_HEADER=

# Paths exempt from the allowlist, for platform health checks. Defaults to
# /healthz. Set to an empty string to exempt nothing.
IP_ALLOWLIST_BYPASS_PATHS=/healthz

# ---------------------------------------------------------------------------
# Seed data (development)
# ---------------------------------------------------------------------------
# If unset, `npm run seed` generates random passwords and prints them once.
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=
